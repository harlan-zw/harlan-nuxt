{
  "name": "@harlan-zw/nuxt-use-query",
  "type": "module",
  "version": "0.1.0",
  "description": "Experimental Nuxt-native query composables with SWR, invalidation, polling, and optimistic cache writes.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "contributors": [
    "Harlan Wilton <harlan@harlan-zw.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/harlan-nuxt/tree/main/packages/nuxt-use-query#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/harlan-nuxt.git",
    "directory": "packages/nuxt-use-query"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/harlan-nuxt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./cache": {
      "types": "./dist/runtime/cache.d.ts",
      "import": "./dist/runtime/cache.js"
    },
    "./async-query": {
      "types": "./dist/runtime/composables/useNuxtAsyncQuery.d.ts",
      "import": "./dist/runtime/composables/useNuxtAsyncQuery.js"
    },
    "./mutation": {
      "types": "./dist/runtime/composables/useNuxtMutation.d.ts",
      "import": "./dist/runtime/composables/useNuxtMutation.js"
    },
    "./query": {
      "types": "./dist/runtime/composables/useNuxtQuery.d.ts",
      "import": "./dist/runtime/composables/useNuxtQuery.js"
    },
    "./query-cache": {
      "types": "./dist/runtime/composables/useQueryCache.d.ts",
      "import": "./dist/runtime/composables/useQueryCache.js"
    },
    "./rpc": {
      "types": "./dist/runtime/rpc/index.d.ts",
      "import": "./dist/runtime/rpc/index.js"
    },
    "./subscription": {
      "types": "./dist/runtime/composables/useNuxtSubscription.d.ts",
      "import": "./dist/runtime/composables/useNuxtSubscription.js"
    },
    "./websocket": {
      "types": "./dist/runtime/websocket.d.ts",
      "import": "./dist/runtime/websocket.js"
    },
    "./telemetry": {
      "types": "./dist/runtime/telemetry.d.ts",
      "import": "./dist/runtime/telemetry.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      "async-query": [
        "./dist/runtime/composables/useNuxtAsyncQuery.d.ts"
      ],
      "cache": [
        "./dist/runtime/cache.d.ts"
      ],
      "mutation": [
        "./dist/runtime/composables/useNuxtMutation.d.ts"
      ],
      "query": [
        "./dist/runtime/composables/useNuxtQuery.d.ts"
      ],
      "query-cache": [
        "./dist/runtime/composables/useQueryCache.d.ts"
      ],
      "rpc": [
        "./dist/runtime/rpc/index.d.ts"
      ],
      "subscription": [
        "./dist/runtime/composables/useNuxtSubscription.d.ts"
      ],
      "websocket": [
        "./dist/runtime/websocket.d.ts"
      ],
      "telemetry": [
        "./dist/runtime/telemetry.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && nuxt prepare playground && nuxt prepare test/fixture",
    "prepare:fixtures": "nuxt prepare playground && nuxt prepare test/fixture",
    "prepack": "pnpm run build",
    "test": "pnpm run prepare:fixtures && vitest run",
    "test:unit": "vitest run --project=unit",
    "test:e2e": "pnpm run prepare:fixtures && vitest run --project=e2e",
    "typecheck": "nuxt typecheck",
    "test:attw": "attw --pack",
    "test:pack": "rm -rf .pack && pnpm pack --pack-destination .pack && tar -tf .pack/*.tgz"
  },
  "peerDependencies": {
    "nuxt": ">=4.5.0 <5.0.0",
    "vite": "^8.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@vueuse/core": "catalog:",
    "consola": "catalog:",
    "nitropack": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-harlanzw": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  }
}
