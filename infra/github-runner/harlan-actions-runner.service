[Unit]
Description=Ephemeral GitHub Actions runners for Harlan sites
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HARLAN_RUNNER_CONFIG=%h/.config/harlan-actions-runner/runners.conf
ExecStart=%h/.local/lib/harlan-actions-runner/supervisor
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
