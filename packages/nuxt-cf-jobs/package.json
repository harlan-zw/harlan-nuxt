{
  "name": "@harlan-zw/nuxt-cf-jobs",
  "type": "module",
  "version": "0.2.2",
  "description": "Experimental Nuxt module for typed Cloudflare queue jobs.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "contributors": [
    "Harlan Wilton <harlan@harlan-zw.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/harlan-nuxt/tree/main/packages/nuxt-cf-jobs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/harlan-nuxt.git",
    "directory": "packages/nuxt-cf-jobs"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/harlan-nuxt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js",
      "default": "./dist/runtime/server/index.js"
    },
    "./app": {
      "types": "./dist/runtime/server/app.d.ts",
      "import": "./dist/runtime/server/app.js",
      "default": "./dist/runtime/server/app.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime/server/runtime-config.d.ts",
      "import": "./dist/runtime/server/runtime-config.js",
      "default": "./dist/runtime/server/runtime-config.js"
    },
    "./cloudflare": {
      "types": "./dist/runtime/server/cloudflare.d.ts",
      "import": "./dist/runtime/server/cloudflare.js",
      "default": "./dist/runtime/server/cloudflare.js"
    },
    "./d1": {
      "types": "./dist/runtime/server/d1.d.ts",
      "import": "./dist/runtime/server/d1.js",
      "default": "./dist/runtime/server/d1.js"
    },
    "./outbox": {
      "types": "./dist/runtime/server/outbox-public.d.ts",
      "import": "./dist/runtime/server/outbox-public.js",
      "default": "./dist/runtime/server/outbox-public.js"
    },
    "./schema": {
      "types": "./dist/runtime/server/schema.d.ts",
      "import": "./dist/runtime/server/schema.js",
      "default": "./dist/runtime/server/schema.js"
    },
    "./sentry": {
      "types": "./dist/runtime/server/sentry.d.ts",
      "import": "./dist/runtime/server/sentry.js",
      "default": "./dist/runtime/server/sentry.js"
    },
    "./testing": {
      "types": "./dist/runtime/server/testing.d.ts",
      "import": "./dist/runtime/server/testing.js",
      "default": "./dist/runtime/server/testing.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      "server": [
        "dist/runtime/server/index.d.ts"
      ],
      "app": [
        "dist/runtime/server/app.d.ts"
      ],
      "runtime-config": [
        "dist/runtime/server/runtime-config.d.ts"
      ],
      "cloudflare": [
        "dist/runtime/server/cloudflare.d.ts"
      ],
      "d1": [
        "dist/runtime/server/d1.d.ts"
      ],
      "outbox": [
        "dist/runtime/server/outbox-public.d.ts"
      ],
      "schema": [
        "dist/runtime/server/schema.d.ts"
      ],
      "sentry": [
        "dist/runtime/server/sentry.d.ts"
      ],
      "testing": [
        "dist/runtime/server/testing.d.ts"
      ]
    }
  },
  "bin": {
    "cf-jobs": "dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --project unit",
    "test:unit": "pnpm run build && vitest run --project unit",
    "test:nitro": "vitest run --project nitro",
    "test:types": "nuxt prepare tests/fixtures/nuxt-demo && vue-tsc --noEmit -p tests/fixtures/nuxt-demo/tsconfig.json",
    "test:e2e": "CF_JOBS_E2E=1 vitest run --no-file-parallelism tests/wrangler-dev.e2e.test.ts tests/wrangler-d1.e2e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tests/cloudflare-tsconfig.json && pnpm test:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:attw": "attw --pack",
    "test:pack": "rm -rf .pack && pnpm pack --pack-destination .pack && tar -tf .pack/*.tgz"
  },
  "peerDependencies": {
    "@sentry/cloudflare": "catalog:",
    "nuxt": ">=4.5.0 <6.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/cloudflare": {
      "optional": true
    }
  },
  "dependencies": {
    "@harlan-zw/nuxt-cloudflare": "workspace:^",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "citty": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-harlanzw": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "h3": "catalog:",
    "happy-dom": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  }
}
