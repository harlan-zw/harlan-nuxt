#!/usr/bin/env bash

# Harlan's desktop GitHub runner: ephemeral Actions runners for every private
# Harlan site, all on this one workstation.
#
# GitHub scopes self-hosted runners to a repository, an organization, or an
# enterprise. Nine of ten sites sit under the user account `harlan-zw`, and
# there is no user scope, so one pool per repository is the only shape available
# without moving repositories into an organization.
#
# HOW DEMAND IS DETECTED
#
# Nothing here polls GitHub. Each container's own runner listener holds a long
# poll against GitHub and prints `Running job:` on stdout the moment it claims
# one. The supervisor reads that line and treats it as the scale-up event, so a
# matrix wider than the warm pool gets extra containers within seconds, and the
# only GitHub API call made is one registration token per container.
#
# SLOT KINDS
#
#   warm   Re-registers forever. `warm` of these exist per pool at rest, so that
#          many jobs start with no wait.
#   burst  Registers once, runs at most one job, then exits. Spawned by the
#          scaler when a slot goes busy. Stopped early if it never claims a job,
#          so a quiet pool falls back to `warm`.
#
# ACCOUNTING
#
# Pool size and CPU spend are counted from files this process writes, never from
# `docker ps`. A wide matrix produces many spawn requests within milliseconds,
# and a container does not appear in `docker ps` immediately, so counting
# containers would burst past `max` every time. The scaler writes each reservation
# before it forks, which makes the count exact.
#
# Only work in flight spends the budget: a warm container spends while it holds a
# job, and a burst container spends from the moment it is launched, because it
# was launched to take one. Idle warm listeners cost about 60 MB and no CPU, so
# charging for them would block every burst on an otherwise idle host.

set -euo pipefail

readonly runner_image="${HARLANS_DESKTOP_RUNNER_IMAGE:-harlans-desktop-github-runner:2.336.0}"
readonly config_file="${HARLANS_DESKTOP_RUNNER_CONFIG:-/etc/harlans-desktop-github-runner/runners.conf}"
# 24 physical cores. Runner work is IO-heavy and rarely saturates its quota, so a
# modest oversubscription keeps a wide matrix moving without starving
# interactive work on the workstation.
readonly cpu_budget="${HARLANS_DESKTOP_RUNNER_CPU_BUDGET:-32}"
# A burst container that has claimed nothing by now is surplus. Stopping it
# returns the pool to `warm` after a quiet spell.
readonly burst_idle_seconds="${HARLANS_DESKTOP_RUNNER_BURST_IDLE_SECONDS:-300}"
readonly container_label='com.harlanzw.desktop-runner'
# Readable by the status command, unlike /tmp under this unit's PrivateTmp.
readonly state_root="${XDG_RUNTIME_DIR:-/tmp}/harlans-desktop-github-runner"
# Copied here at startup so the status command can size pools without reading a
# config path it would otherwise have to guess.
readonly published_config="$state_root/runners.conf"

state_dir=''
scale_pipe=''

# Pool table, filled by read_config. The array index is the pool id used
# everywhere else.
declare -a pool_repository=()
declare -a pool_label=()
declare -a pool_warm=()
declare -a pool_max=()
declare -a pool_cpus=()
declare -a pool_memory=()
declare -a pool_memory_swap=()
declare -a pool_slug=()

log() {
  printf '%s %s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" "$*"
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    log "Required command is unavailable: $command_name"
    return 1
  fi
}

# `harlan-zw/nuxtseo.com` + `harlans-desktop-ci` -> `nuxtseo-com-ci`. Used for container
# names and the Docker pool label, both of which reject `/` and `.`.
#
# A pool may carry several labels, so that a repository can answer to both its
# old label and the shared one while its workflows are migrated. The first label
# names the pool.
pool_slug_for() {
  local repository="$1"
  local label="${2%%,*}"

  printf '%s-%s' "${repository##*/}" "${label#harlans-desktop-}" \
    | tr --complement --squeeze-repeats '[:alnum:]-' '-' \
    | tr '[:upper:]' '[:lower:]'
}

read_config() {
  local repository label warm max cpus memory memory_swap

  if [[ ! -r "$config_file" ]]; then
    log "Runner config is unreadable: $config_file"
    return 1
  fi

  while IFS='|' read -r repository label warm max cpus memory memory_swap; do
    # Skip comments and blank lines. Leading whitespace is tolerated so the file
    # can be indented.
    repository="${repository#"${repository%%[![:space:]]*}"}"
    [[ -z "$repository" || "$repository" == \#* ]] && continue

    if [[ -z "$memory_swap" ]]; then
      log "Ignoring malformed pool line: $repository"
      continue
    fi

    pool_repository+=("$repository")
    pool_label+=("$label")
    pool_warm+=("$warm")
    pool_max+=("$max")
    pool_cpus+=("$cpus")
    pool_memory+=("$memory")
    pool_memory_swap+=("$memory_swap")
    pool_slug+=("$(pool_slug_for "$repository" "$label")")
  done <"$config_file"

  if (( ${#pool_repository[@]} == 0 )); then
    log "No runner pools are defined in $config_file"
    return 1
  fi
}

# Sum of a marker directory's contents. Each file is named after its container,
# so concurrent slots create and remove distinct paths and never contend.
sum_markers() {
  local directory="$1"
  local total=0
  local file value

  for file in "$directory"/*; do
    [[ -f "$file" ]] || continue
    read -r value <"$file" || continue
    total=$(( total + value ))
  done

  printf '%s' "$total"
}

count_markers() {
  local directory="$1"
  local total=0
  local file

  for file in "$directory"/*; do
    [[ -f "$file" ]] && total=$(( total + 1 ))
  done

  printf '%s' "$total"
}

reserve() {
  local container_name="$1"
  local cpus="$2"

  printf '%s\n' "$cpus" >"$state_dir/spend/$container_name"
}

release() {
  local container_name="$1"

  rm --force "$state_dir/spend/$container_name"
}

# Stops a burst container that registered but never claimed anything. The runner
# deregisters itself on SIGTERM, so no orphan is left in the repository's runner
# list.
reap_idle_burst() {
  local container_name="$1"

  sleep "$burst_idle_seconds"

  if [[ -f "$state_dir/claimed/$container_name" ]]; then
    return 0
  fi

  log "Retiring idle burst runner $container_name"
  docker stop --time 20 "$container_name" >/dev/null 2>&1 || true
}

# Runs one container to completion. Returns the container's exit status.
run_container() {
  local pool_index="$1"
  local slot_kind="$2"
  local container_name="$3"

  local repository="${pool_repository[$pool_index]}"
  local registration_token
  local runner_name
  local line
  local -a pipe_status=()

  if ! registration_token="$(gh api \
    --method POST \
    "repos/$repository/actions/runners/registration-token" \
    --jq .token 2>/dev/null)"; then
    log "Could not get a registration token for $repository"
    return 1
  fi

  # This string is what a job's log prints as `Runner name:`, and it is the only
  # place a reader sees whose machine ran their code. Lead with the machine, not
  # the pool.
  runner_name="harlans-desktop-${pool_slug[$pool_index]}-$$-${RANDOM}"

  # The token enters on stdin, so it never lands on disk and never lands in an
  # env var that `docker inspect` would echo back.
  #
  # errexit is lifted across the pipeline so the container's exit status can be
  # read from PIPESTATUS instead of aborting this function.
  set +e
  printf '%s\n' "$registration_token" | docker run \
    --rm \
    --interactive \
    --name "$container_name" \
    --label "$container_label=true" \
    --label "$container_label.pool=${pool_slug[$pool_index]}" \
    --label "$container_label.repository=$repository" \
    --cpus "${pool_cpus[$pool_index]}" \
    --memory "${pool_memory[$pool_index]}" \
    --memory-swap "${pool_memory_swap[$pool_index]}" \
    --pids-limit 4096 \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --env "RUNNER_LABELS=${pool_label[$pool_index]}" \
    --env "RUNNER_NAME=$runner_name" \
    --env "RUNNER_URL=https://github.com/$repository" \
    "$runner_image" 2>&1 \
    | while IFS= read -r line; do
        printf '[%s] %s\n' "$container_name" "$line"

        # The runner prints this the instant it claims a job. It is the only
        # demand signal in this system.
        if [[ "$line" == *'Running job:'* && ! -f "$state_dir/claimed/$container_name" ]]; then
          : >"$state_dir/claimed/$container_name"
          # A burst container reserved its CPU when the scaler launched it.
          # Charging again here would double count it.
          if [[ "$slot_kind" == warm ]]; then
            reserve "$container_name" "${pool_cpus[$pool_index]}"
          fi
          printf 'spawn %s\n' "$pool_index" >"$scale_pipe"
        fi
      done
  pipe_status=("${PIPESTATUS[@]}")
  set -e

  rm --force "$state_dir/claimed/$container_name"
  [[ "$slot_kind" == warm ]] && release "$container_name"

  # Index 1 is `docker run`. Index 0 is the token `printf`, which cannot fail in
  # a way worth restarting a slot for.
  return "${pipe_status[1]}"
}

# A warm slot never gives its place up. If Docker or GitHub is unavailable it
# backs off and tries again, because the alternative is a pool that silently
# shrinks to nothing after a transient failure.
run_warm_slot() {
  local pool_index="$1"
  local slot_number="$2"
  local container_name="harlans-desktop-${pool_slug[$pool_index]}-$slot_number"

  while true; do
    if ! run_container "$pool_index" warm "$container_name"; then
      docker rm --force "$container_name" >/dev/null 2>&1 || true
      sleep 10
    fi
  done
}

# The scaler reserved this slot before forking, so every exit path must release
# it or the pool leaks capacity for the lifetime of the process.
run_burst_slot() {
  local pool_index="$1"
  local container_name="$2"

  reap_idle_burst "$container_name" &
  local reaper_pid=$!

  run_container "$pool_index" burst "$container_name" || true

  kill "$reaper_pid" >/dev/null 2>&1 || true
  docker rm --force "$container_name" >/dev/null 2>&1 || true
  rm --force "$state_dir/burst/${pool_slug[$pool_index]}/$container_name"
  release "$container_name"
}

# Blocking reader over the scale pipe. No timers and no polling: it wakes only
# when a slot reports that it went busy.
run_scaler() {
  local request pool_index container_name
  local burst_counter=0
  local slug live spent

  while true; do
    while IFS=' ' read -r request pool_index; do
      [[ "$request" == spawn ]] || continue

      slug="${pool_slug[$pool_index]}"
      live=$(( pool_warm[pool_index] + $(count_markers "$state_dir/burst/$slug") ))
      if (( live >= pool_max[pool_index] )); then
        continue
      fi

      spent="$(sum_markers "$state_dir/spend")"
      if (( spent + pool_cpus[pool_index] > cpu_budget )); then
        log "CPU budget spent ($spent of $cpu_budget); holding $slug at $live"
        continue
      fi

      burst_counter=$(( burst_counter + 1 ))
      container_name="harlans-desktop-$slug-burst-$burst_counter"
      # Both reservations are written before the fork, so the next request in
      # this loop already sees this container.
      printf '%s\n' "${pool_cpus[$pool_index]}" >"$state_dir/burst/$slug/$container_name"
      reserve "$container_name" "${pool_cpus[$pool_index]}"

      log "Bursting $slug to $(( live + 1 )) of ${pool_max[$pool_index]}"
      run_burst_slot "$pool_index" "$container_name" &
    done <"$scale_pipe"
    # The read loop ends only if every writer closes the pipe. Reopen it.
  done
}

# An ephemeral runner deregisters itself when it exits cleanly, but a host that
# lost power, or a `docker kill`, leaves the registration behind. They accumulate
# against the repository's runner limit and make `gh api ... /runners` unreadable,
# so clear them once at startup. Only offline runners are touched, and a runner
# this supervisor is about to create is not registered yet.
prune_offline_runners() {
  local repository="$1"
  local -a runner_ids=()
  local runner_id

  if ! mapfile -t runner_ids < <(gh api --paginate \
    "repos/$repository/actions/runners" \
    --jq '.runners[] | select(.status == "offline") | .id' 2>/dev/null); then
    return 0
  fi

  for runner_id in "${runner_ids[@]}"; do
    [[ -n "$runner_id" ]] || continue
    gh api --method DELETE "repos/$repository/actions/runners/$runner_id" >/dev/null 2>&1 || true
  done

  if (( ${#runner_ids[@]} > 0 )); then
    log "Pruned ${#runner_ids[@]} offline runner registrations from $repository"
  fi
}

stop_all_containers() {
  local -a container_ids=()

  mapfile -t container_ids < <(docker ps --quiet --filter "label=$container_label=true")
  if (( ${#container_ids[@]} > 0 )); then
    docker stop --time 20 "${container_ids[@]}" >/dev/null 2>&1 || true
  fi
}

cleanup() {
  stop_all_containers
  [[ -n "$state_dir" && -d "$state_dir" ]] && rm --recursive --force "$state_dir"
  return 0
}

main() {
  require_command docker
  require_command gh

  if ! docker image inspect "$runner_image" >/dev/null 2>&1; then
    log "Runner image is unavailable; build $runner_image from infra/github-runner."
    return 1
  fi

  read_config

  # A fixed path under the runtime directory, not mktemp under /tmp. The unit sets
  # PrivateTmp, so anything in /tmp is invisible to `harlans-desktop-runner status`
  # and the counts it reports would have to be guessed from `docker ps` instead of
  # read from the real reservations.
  state_dir="$state_root"
  rm --recursive --force "$state_dir"
  mkdir --parents "$state_dir/spend" "$state_dir/claimed" "$state_dir/burst"
  scale_pipe="$state_dir/scale"
  cp "$config_file" "$published_config"
  mkfifo --mode 0600 "$scale_pipe"

  # Leftovers from a previous supervisor hold registrations this process cannot
  # track.
  stop_all_containers
  trap cleanup EXIT INT TERM

  local pool_index slot_number
  local -A pruned_repositories=()
  for pool_index in "${!pool_repository[@]}"; do
    mkdir --parents "$state_dir/burst/${pool_slug[$pool_index]}"

    # A repository can own several pools. Prune it once.
    if [[ -z "${pruned_repositories[${pool_repository[$pool_index]}]:-}" ]]; then
      pruned_repositories[${pool_repository[$pool_index]}]=done
      prune_offline_runners "${pool_repository[$pool_index]}"
    fi
  done

  run_scaler &

  # Hold the pipe open for writing for this process's lifetime, so the scaler's
  # read loop never sees end-of-file between bursts.
  exec {scale_pipe_holder}>"$scale_pipe"

  for pool_index in "${!pool_repository[@]}"; do
    log "Pool ${pool_slug[$pool_index]}: ${pool_repository[$pool_index]} warm ${pool_warm[$pool_index]} max ${pool_max[$pool_index]} cpus ${pool_cpus[$pool_index]}"
    for slot_number in $(seq 1 "${pool_warm[$pool_index]}"); do
      run_warm_slot "$pool_index" "$slot_number" &
    done
  done

  wait
}

main "$@"
